# Copy to .env and fill in. .env is gitignored. NEVER commit real keys.

# ---- Data tier -------------------------------------------------------------
# REUSE the project you provisioned for the first product. Do not create a
# second one: the free tier allows two active projects per person and later
# topics need the headroom. Apply db/migrations/002_topic2.sql on top of the
# schema that is already there — migrations are additive and numbered for
# exactly this reason.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key — safe for the Streamlit read-only views>
SUPABASE_SERVICE_ROLE_KEY=<service-role key — SERVICE TIER ONLY, never in ui/>

# ---- Service tier ----------------------------------------------------------
# "inprocess" -> the Streamlit app imports the FastAPI handlers directly
#                (this is what runs on Streamlit Community Cloud).
# "http"      -> the Streamlit app calls SERVICE_URL over HTTP
#                (this is what you demonstrate locally under uvicorn).
SERVICE_MODE=inprocess
SERVICE_URL=http://127.0.0.1:8000

# ---- Artifacts -------------------------------------------------------------
POLICY_DIR=policies
# Which artifact an unqualified /act request gets. This product ships two, so
# "resolve the default when there is exactly one" no longer decides anything.
# Pointed at the exact solution: a caller who does not choose gets the answer
# that is provably right rather than the one that was learned.
DEFAULT_POLICY=value_iteration
APP_VERSION=0.2.0
GIT_SHA=local
