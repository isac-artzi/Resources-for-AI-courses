# Copy to .env and fill in. .env is gitignored. NEVER commit real keys.

# ---- Data tier -------------------------------------------------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key — safe for the Streamlit read-only views>
SUPABASE_SERVICE_ROLE_KEY=<service-role key — SERVICE TIER ONLY, never in ui/>

# ---- Service tier ----------------------------------------------------------
# "inprocess" -> the Streamlit app imports the FastAPI handlers directly
#                (this is what runs on Streamlit Community Cloud).
# "http"      -> the Streamlit app calls SERVICE_URL over HTTP
#                (this is what you demonstrate locally under uvicorn).
SERVICE_MODE=inprocess
SERVICE_URL=http://127.0.0.1:8000

# ---- Artifacts -------------------------------------------------------------
POLICY_DIR=policies
APP_VERSION=0.1.0
GIT_SHA=local

# ---- Topic 6 ---------------------------------------------------------------
# OPTIONAL, and only for the Step 12 extension that scores arbitrary user text
# with the stronger EMBEDDING head via the Hugging Face Inference API. The
# required build does not call any external inference service, and adding one
# adds a failure mode the model card must describe: a third party now sees
# every string your users paste, and /score's latency becomes someone else's
# uptime. Attempt it only after the required build works.
HF_API_TOKEN=

# Which registered head POST /score uses when the caller does not say.
# `reward_tfidf` is the only one that is self-contained enough to serve.
DEFAULT_REWARD_HEAD=reward_tfidf
