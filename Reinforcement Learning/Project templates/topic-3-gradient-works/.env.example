# Copy to .env and fill in. .env is gitignored. NEVER commit real keys.

# ---- Data tier -------------------------------------------------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key — safe for the Streamlit read-only views>
SUPABASE_SERVICE_ROLE_KEY=<service-role key — SERVICE TIER ONLY, never in ui/>

# ---- Service tier ----------------------------------------------------------
# "inprocess" -> the Streamlit app imports the FastAPI handlers directly
#                (this is what runs on Streamlit Community Cloud).
# "http"      -> the Streamlit app calls SERVICE_URL over HTTP
#                (this is what you demonstrate locally under uvicorn).
SERVICE_MODE=inprocess
SERVICE_URL=http://127.0.0.1:8000

# ---- Artifacts -------------------------------------------------------------
POLICY_DIR=policies

# Which artifact `policy_name="default"` resolves to. From Topic 3 on there is
# more than one .npz in policies/ — the base template's smoke-test table and the
# network you trained — so "the only one" is no longer a rule that can pick, and
# /rollout and the Streamlit Play tab both send "default". Point this at the run
# you are promoting; if it names an artifact that does not exist, /act answers
# 404 listing the ones that do rather than quietly serving a stale policy.
DEFAULT_POLICY=vpg_cartpole

APP_VERSION=0.1.0
GIT_SHA=local
