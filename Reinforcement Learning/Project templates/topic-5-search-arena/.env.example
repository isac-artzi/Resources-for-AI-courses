# Copy to .env and fill in. .env is gitignored. NEVER commit real keys.

# ---- Data tier -------------------------------------------------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key — safe for the Streamlit read-only views>
SUPABASE_SERVICE_ROLE_KEY=<service-role key — SERVICE TIER ONLY, never in ui/>

# ---- Service tier ----------------------------------------------------------
# "inprocess" -> the Streamlit app imports the FastAPI handlers directly
#                (this is what runs on Streamlit Community Cloud).
# "http"      -> the Streamlit app calls SERVICE_URL over HTTP
#                (this is what you demonstrate locally under uvicorn).
SERVICE_MODE=inprocess
SERVICE_URL=http://127.0.0.1:8000

# ---- Artifacts -------------------------------------------------------------
POLICY_DIR=policies
APP_VERSION=0.5.0
GIT_SHA=local

# ---- Topic 5: search budgets ----------------------------------------------
# Not read by shared/config.py — the budget is a REQUEST field, not a server
# setting, because it belongs to the caller's cost decision rather than to the
# deployment. These two lines are here as documentation of the numbers in
# shared/schemas.py, so that someone tuning the deployment knows where to look:
#
#   DEFAULT_NODE_BUDGET = 200_000   what an unqualified /act request gets
#   MAX_NODE_BUDGET     = 2_000_000 the most a caller may ask for (422 above it)
#
# If your instance is smaller than a free-tier Streamlit container, lower them
# in shared/schemas.py and re-run tests/test_node_budget.py.
