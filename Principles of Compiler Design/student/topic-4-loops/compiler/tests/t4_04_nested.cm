/* Expected output: 225  9
 * A nested loop is the first program whose cost is not linear in its length. */
int main() {
    int i; int j; int s; int c;
    s = 0; c = 0;
    for (i = 1; i <= 5; i = i + 1) {
        for (j = 1; j <= 5; j = j + 1) { s = s + i * j; c = c + 1; }
    }
    print(s);        /* (1+..+5)^2 = 225 */
    print(c - 16);   /* 25 iterations - 16 = 9 */
    return 0;
}
