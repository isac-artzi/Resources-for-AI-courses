/* A deliberately hot loop, for the Topic 6 performance write-up.
 * Expected output: 30300  (sum over i=1..100, j=1..3 of i*j = 6 * 5050)
 * Compile with and without optimization and compare BOTH the TAC instruction
 * count and the instruction count SPIM reports for the run. */
int main() {
    int i; int j; int s;
    s = 0;
    for (i = 1; i <= 100; i = i + 1) {
        for (j = 1; j <= 3; j = j + 1) { s = s + i * j + 0; }
    }
    print(s);
    return 0;
}
