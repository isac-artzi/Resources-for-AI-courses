# Copy to .env for local API development. Never commit .env.
# The API uses the SERVICE-ROLE key. It must never appear in the ui/ tier.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Bump this string whenever you change the chunking parameters, the embedding
# model, the generator, or the prompt. Every logged query carries it.
MODEL_VERSION=askmydocs-v1

# Comma-separated CORS origins. "*" is fine for a course project.
ALLOWED_ORIGINS=*

# Only if you generate through a hosted inference API instead of loading model
# weights in the service — which is the realistic choice on a free plan.
# HF_API_TOKEN=your-token
