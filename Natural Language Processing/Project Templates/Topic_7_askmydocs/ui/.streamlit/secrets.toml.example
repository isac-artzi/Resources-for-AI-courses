# Copy to ui/.streamlit/secrets.toml locally, and paste the same three keys into
# the "Secrets" box when you deploy on Streamlit Community Cloud.
# The real secrets.toml is gitignored. Keep it that way.

API_URL = "https://your-service.onrender.com"
SUPABASE_URL = "https://your-project-ref.supabase.co"

# The ANON key is safe to expose: row-level security limits it to SELECT, and
# there is no anonymous INSERT policy anywhere in the migration. Putting the
# SERVICE-ROLE key here would hand every visitor write access to your database.
#
# Note what anonymous SELECT means for this product specifically: the chunks
# table holds your passages in full, so everything you ingest is readable by
# anyone who opens the app. That is correct for a collection of public documents
# and wrong for anyone's real knowledge base.
SUPABASE_ANON_KEY = "your-anon-key"
