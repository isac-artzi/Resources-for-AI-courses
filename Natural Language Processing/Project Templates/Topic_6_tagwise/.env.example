# Copy to .env for local API development. Never commit .env.
# The API uses the SERVICE-ROLE key. It must never appear in the ui/ tier.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Bump this whenever you rebuild a tagger: a new lookup table, a new fine-tune,
# a changed fallback rule. Every runs row and every taggings row carries it.
MODEL_VERSION=tagwise-v1

# Comma-separated CORS origins. "*" is fine for a course project.
ALLOWED_ORIGINS=*
