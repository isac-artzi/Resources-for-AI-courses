# Copy to .env for local API development. Never commit .env.
# The API uses the SERVICE-ROLE key. It must never appear in the ui/ tier.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Coarse version of the deployed configuration, reported by GET /version.
# Individual predictions carry the version of the ARTIFACT that answered them,
# which is the one that matters for auditing.
MODEL_VERSION=classify-it-v1

# Comma-separated CORS origins. "*" is fine for a course project.
ALLOWED_ORIGINS=*

# Where trained artifacts live locally. The web service reads from here; it never
# writes here, because it never trains.
ARTIFACT_DIR=artifacts

# Keep the Hugging Face cache somewhere stable so a cold start does not
# re-download the tokenizer.
HF_HOME=.cache/huggingface
