# Copy to .env for local API development. Never commit .env.
# The API uses the SERVICE-ROLE key. It must never appear in the ui/ tier.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Bump this whenever you retrain or change the serving configuration. Every
# logged prediction carries it; GET /version reports it; the audit trail joins
# on it.
MODEL_VERSION=moodlens-v1

# The checkpoint you fine-tuned FROM. Reported by /version and by the model card.
BASE_MODEL=distilbert-base-uncased

# Where load_classifier() looks for your fine-tuned weights. A local directory
# during development; on Render, either a path inside the repo or a Hugging Face
# model id you pushed to the Hub.
MODEL_DIR=./models/moodlens-v1

# Where the calibrator fitted on the validation split lives. Leave it unset and
# the service serves raw scores with calibrated=false, which is honest but is
# not what the product brief asked for.
CALIBRATOR_PATH=./models/moodlens-v1/calibrator.joblib

# Keeps model downloads out of the ephemeral home directory on Render.
HF_HOME=/tmp/hf

# Comma-separated CORS origins. "*" is fine for a course project.
ALLOWED_ORIGINS=*
