# Copy to .env for local API development. Never commit .env.
# The API uses the SERVICE-ROLE key. It must never appear in the ui/ tier.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Bump this string whenever you retrain, change the label set, or change the
# BIO decoding rules. Every extraction row carries it.
MODEL_VERSION=entityfinder-v1

# Predictions scoring below this go to the review queue. Your team's number.
CONFIDENCE_THRESHOLD=0.85

# Where the fine-tuned token classifier lives: a local directory or a model id.
NER_MODEL=./models/entityfinder-transformer

# Where the pickled CRF baseline lives.
CRF_MODEL_PATH=./models/entityfinder-crf.pkl

# Comma-separated CORS origins. "*" is fine for a course project.
ALLOWED_ORIGINS=*
