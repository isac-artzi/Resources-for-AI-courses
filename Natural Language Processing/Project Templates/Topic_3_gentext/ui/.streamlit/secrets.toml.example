# Copy to ui/.streamlit/secrets.toml locally, and paste the same three keys into
# the "Secrets" box when you deploy on Streamlit Community Cloud.
# The real secrets.toml is gitignored. Keep it that way.

API_URL = "https://your-service.onrender.com"
SUPABASE_URL = "https://your-project-ref.supabase.co"

# The ANON key is safe to expose: row-level security limits it to SELECT on the
# generations and training_runs tables. It cannot write, which is why the rating
# form posts to the API instead of writing here. Putting the SERVICE-ROLE key in
# this file would hand every visitor the ability to rewrite your ratings.
SUPABASE_ANON_KEY = "your-anon-key"
