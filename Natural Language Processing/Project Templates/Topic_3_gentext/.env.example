# Copy to .env for local API development. Never commit .env.
# The API uses the SERVICE-ROLE key. It must never appear in the ui/ tier.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# The checkpoint this instance serves. Start with the base model; point it at
# your own fine-tuned model on the Hugging Face Hub once you have published one.
MODEL_NAME=gpt2

# Bump this whenever the weights or the decoding defaults change. It is stamped
# on every generation row and joins back to the training_runs table.
MODEL_VERSION=gentext-v1

# Comma-separated CORS origins. "*" is fine for a course project.
ALLOWED_ORIGINS=*

# Where Hugging Face caches downloaded weights. Set it on Render if you use a
# persistent disk; otherwise every cold start re-downloads the model.
# HF_HOME=/opt/render/project/.cache/huggingface
