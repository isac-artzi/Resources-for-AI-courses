# Copy to .env for local API development. Never commit .env.
# The API uses the SERVICE-ROLE key. It must never appear in the ui/ tier.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Bump this string whenever you change preprocessing rules or the tokenizer set.
MODEL_VERSION=tokenforge-v1

# Comma-separated CORS origins. "*" is fine for a course project.
ALLOWED_ORIGINS=*
